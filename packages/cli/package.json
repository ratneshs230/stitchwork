{
  "name": "@stitchwork/cli",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "stitchwork": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node --experimental-strip-types --no-warnings src/bin.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'lint: cli ok'"
  },
  "dependencies": {
    "@stitchwork/parser-ts": "workspace:*",
    "@stitchwork/shared-schemas": "workspace:*",
    "commander": "^12.1.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.5.0"
  }
}
